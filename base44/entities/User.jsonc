{
  "name": "User",
  "type": "object",
  "properties": {
    "user_type": {
      "type": "string",
      "enum": [
        "talent",
        "seeker",
        "both"
      ],
      "description": "Type of user account"
    },
    "phone": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "preferred_city": {
      "type": "string"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_type",
    "phone",
    "profile_photo",
    "preferred_city"
  ]
}