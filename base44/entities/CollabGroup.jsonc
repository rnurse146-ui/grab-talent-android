{
  "name": "CollabGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Group chat title, chosen by the performer who created it"
    },
    "owner_id": {
      "type": "string",
      "description": "User ID of the performer who created the group \u2014 written only by the collabGroups backend function"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs in the group (creator first) \u2014 written only by the collabGroups backend function"
    },
    "member_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Stage names matching member_ids, for display"
    }
  },
  "required": [
    "name",
    "owner_id",
    "member_ids"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}