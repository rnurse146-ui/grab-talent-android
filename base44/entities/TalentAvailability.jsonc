{
  "name": "TalentAvailability",
  "type": "object",
  "properties": {
    "talent_profile_id": {
      "type": "string",
      "description": "Reference to TalentProfile"
    },
    "talent_user_id": {
      "type": "string",
      "description": "User ID of the talent"
    },
    "blocked_dates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "description": "Array of ISO date strings that are blocked/unavailable"
    },
    "booking_dates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "description": "Auto-populated dates from confirmed bookings"
    }
  },
  "required": [
    "talent_profile_id",
    "talent_user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.talent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.talent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.talent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}