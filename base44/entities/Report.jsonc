{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string",
      "description": "User who reported \u2014 written only by the reportUser backend function"
    },
    "reporter_name": {
      "type": "string"
    },
    "reported_user_id": {
      "type": "string",
      "description": "User being reported"
    },
    "reported_name": {
      "type": "string",
      "description": "Display name of the reported user"
    },
    "reported_profile_id": {
      "type": "string",
      "description": "TalentProfile of the reported user, when the report came from a profile"
    },
    "context": {
      "type": "string",
      "enum": [
        "direct_chat",
        "collab_chat",
        "profile",
        "booking",
        "other"
      ],
      "description": "Where the reported behaviour happened"
    },
    "group_id": {
      "type": "string",
      "description": "CollabGroup the reported message was in, if any"
    },
    "conversation_id": {
      "type": "string",
      "description": "Direct conversation the reported message was in, if any"
    },
    "excerpt": {
      "type": "string",
      "description": "The reported message text, copied server-side from the caller's submission"
    },
    "reason": {
      "type": "string",
      "enum": [
        "harassment",
        "rude_language",
        "spam",
        "fake_profile",
        "other"
      ],
      "description": "What the reporter says happened"
    },
    "details": {
      "type": "string",
      "description": "The reporter's own description of the problem"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "reviewed",
        "dismissed"
      ],
      "default": "open",
      "description": "Review state \u2014 changed only by an admin"
    },
    "ai_verdict": {
      "type": "string",
      "enum": [
        "clean",
        "rude_language",
        "spam",
        "harassment",
        "threat",
        "fake_profile",
        "unclear",
        "unreviewed"
      ],
      "description": "Automated review of the reported text"
    },
    "ai_severity": {
      "type": "number",
      "description": "Automated severity score from 1 (harmless) to 5 (severe)"
    },
    "ai_summary": {
      "type": "string",
      "description": "One-line automated summary shown to the reviewing admin"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Admin user id who reviewed the report"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the report was reviewed"
    }
  },
  "required": [
    "reporter_id",
    "reported_user_id",
    "reason"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}