{
  "name": "Review",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "description": "Reference to Booking"
    },
    "talent_profile_id": {
      "type": "string",
      "description": "Reference to TalentProfile"
    },
    "reviewer_id": {
      "type": "string",
      "description": "User ID of reviewer"
    },
    "reviewer_name": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "description": "Rating 1-5"
    },
    "review_text": {
      "type": "string",
      "description": "Written review"
    },
    "event_type": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "booking_id",
    "talent_profile_id",
    "reviewer_id",
    "rating"
  ],
  "rls": {
    "create": {
      "data.reviewer_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.reviewer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.reviewer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}