{
  "name": "NetworkSwipe",
  "type": "object",
  "properties": {
    "swiper_user_id": {
      "type": "string",
      "description": "Talent who made the swipe \u2014 written only by the networkSwipe backend function"
    },
    "swiper_profile_id": {
      "type": "string",
      "description": "TalentProfile of the swiper"
    },
    "target_profile_id": {
      "type": "string",
      "description": "TalentProfile they swiped on"
    },
    "target_user_id": {
      "type": "string",
      "description": "User ID of the talent they swiped on"
    },
    "action": {
      "type": "string",
      "enum": [
        "collab",
        "pass"
      ],
      "description": "collab = wants to work with them, pass = not interested"
    },
    "target_seen": {
      "type": "boolean",
      "default": false,
      "description": "Whether the person receiving a one-way collab request has already been shown the pop-up \u2014 written only by the collabPings backend function"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the pending-request reminder (in-app and email) has already gone out for this request \u2014 written only by the sendPendingRequestReminders backend function",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "swiper_user_id",
    "target_profile_id",
    "action"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.swiper_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}