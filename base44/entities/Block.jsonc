{
  "name": "Block",
  "type": "object",
  "properties": {
    "blocker_id": {
      "type": "string",
      "description": "User who blocked \u2014 records are written only by the blockUser backend function"
    },
    "blocked_user_id": {
      "type": "string",
      "description": "User who can no longer see the profile, match or message the blocker"
    },
    "blocker_name": {
      "type": "string",
      "description": "Display name of the blocker, kept for the block list"
    },
    "blocked_name": {
      "type": "string",
      "description": "Display name of the blocked user, kept for the block list"
    }
  },
  "required": [
    "blocker_id",
    "blocked_user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.blocker_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.blocker_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}