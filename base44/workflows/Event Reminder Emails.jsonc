{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 10 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every morning at 10am, emails the talent and the client one day before their booking with the date, start time, venue and each other's details",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "event_reminder_emails",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendEventReminders"
          },
          "then": "end",
          "x-base44": {
            "title": "Send tomorrow's reminders",
            "description": "Emails both sides for tomorrow's active bookings"
          }
        }
      }
    ]
  },
  "name": "Event Reminder Emails"
}