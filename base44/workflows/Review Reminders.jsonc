{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 11 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every morning at 11am, notifies seekers whose event date has passed so they can rate the talent and leave a review",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "review_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_review_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendReviewReminders"
          },
          "then": "end",
          "x-base44": {
            "title": "Ask for reviews",
            "description": "Notifies seekers about past events they haven't reviewed"
          }
        }
      }
    ]
  },
  "name": "Review Reminders"
}